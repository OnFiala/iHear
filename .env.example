# Local values are generated by python3 scripts/local.py start.
# Never put credentials in NEXT_PUBLIC_ variables or Git.
APP_PUBLIC_ORIGIN=http://localhost:3000
DEV_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=3
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-generated-service-role-key
IHEAR_RATE_LIMIT_SALT=replace-with-random-local-value
AUDIO_BUCKET=ihear-audio
REPORT_BUCKET=ihear-reports
QUEUE_NAME=ihear_jobs
PIPELINE_VERSION=1
REPORT_VERSION=4
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
ASTRA_REASONING_EFFORT=low
WORKER_CONCURRENCY=1
CLINIC_TIMEZONE=Europe/Prague
# Budget ceilings live in ihear.budget_accounts; change only through a reviewed migration.
