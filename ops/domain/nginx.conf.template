# Owner-only custom-domain ingress. This file is loaded in nginx's http context.
# Cloudflare Tunnel Protect with Access must validate the exact configured Access
# application before traffic reaches 127.0.0.1:8081. Do not add trust-header auth.

map $uri $ihear_domain_route_class {
    default                                      other;
    /                                           home;
    /clinic                                     clinic;
    /clinic/patients/new                        clinic_patient_new;
    ~^/clinic/patients/[^/]+/?$                  clinic_patient;
    ~^/pair/[^/]+/?$                             pair;
    /app                                        patient_home;
    /app/pair                                   patient_pair;
    ~^/app/events/[^/]+/?$                       patient_event;
    /api/session                                api_session;
    ~^/api/pair/[^/]+/?$                         api_pair;
    ~^/api/patients/[^/]+/pairing/?$             api_pair;
    ~^/api/events(?:/[^/]+)?/?$                  api_events;
    ~^/api/patients(?:/[^/]+)?/?$                api_patients;
    ~^/api/patients/[^/]+/report(?:/download)?/?$ api_report;
    ~^/_next/                                    static_asset;
    /sw.js                                      service_worker;
    /manifest.webmanifest                      manifest;
}

map $cookie_ihear_visit $ihear_domain_visitor {
    "~^[0-9a-f]{32}$" $cookie_ihear_visit;
    default          $request_id;
}

map $cookie_ihear_visit $ihear_domain_set_visit_cookie {
    "~^[0-9a-f]{32}$" "";
    default "ihear_visit=$request_id; Max-Age=2592000; Path=/; Secure; HttpOnly; SameSite=Lax";
}

log_format ihear_domain_privacy escape=json
    '{"timestamp":"$time_iso8601","unix_timestamp":$msec,'
    '"request_id":"$request_id","method":"$request_method",'
    '"route":"$ihear_domain_route_class","status":$status,'
    '"duration_seconds":$request_time,"bytes":$bytes_sent,'
    '"visitor":"$ihear_domain_visitor"}';

# These admission limits are intentionally separate from private port 8080.
limit_req_zone $server_name zone=ihear_domain_requests:1m rate=20r/s;
limit_conn_zone $server_name zone=ihear_domain_connections:1m;

server {
    listen 127.0.0.1:8081 default_server;
    server_name _;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    return 444;
}

server {
    listen 127.0.0.1:8081;
    server_name ihear.ofops.co;
    server_tokens off;

    limit_req zone=ihear_domain_requests burst=100 nodelay;
    limit_req_status 429;
    limit_conn ihear_domain_connections 24;
    limit_conn_status 429;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    keepalive_requests 100;
    send_timeout 20s;

    access_log /var/log/ihear-domain/access.jsonl ihear_domain_privacy;
    # Error output can include raw request targets. HTTP status remains logged above.
    error_log /dev/null crit;
    add_header Set-Cookie $ihear_domain_set_visit_cookie always;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host ihear.ofops.co;
        proxy_set_header X-Forwarded-Host ihear.ofops.co;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID $request_id;
        # Identity is enforced by Cloudflare Access at the dedicated connector.
        # Do not turn these unverified headers into application authorization.
        proxy_set_header Cf-Access-Authenticated-User-Email "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header CF-IPCountry "";
        proxy_set_header CF-Ray "";
        proxy_set_header Tailscale-User-Login "";
        proxy_set_header Tailscale-User-Name "";
        proxy_set_header Tailscale-User-Profile-Pic "";
        proxy_set_header Tailscale-Headers-Info "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        client_body_timeout 20s;
        client_max_body_size 3m;
        client_body_buffer_size 3m;
        client_body_in_single_buffer on;
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;
    }
}
