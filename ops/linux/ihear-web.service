[Unit]
Description=iHear private Next.js application
Requires=ihear-stack.service
After=ihear-stack.service

[Service]
Type=simple
User=ondrej
Group=ondrej
WorkingDirectory=/home/ondrej/iHear
Environment=PATH=/home/ondrej/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=OPENAI_API_KEY=
UMask=0077
ExecStart=/home/ondrej/.local/bin/node /home/ondrej/iHear/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ondrej/iHear/.next

[Install]
WantedBy=multi-user.target
